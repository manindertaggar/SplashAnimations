<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pick_a_splash_animation"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonTerminal"
            style="@style/SplashDemoButton"
            android:text="@string/animation_terminal" />

        <Button
            android:id="@+id/buttonFade"
            style="@style/SplashDemoButton"
            android:text="@string/animation_fade" />

        <Button
            android:id="@+id/buttonZoom"
            style="@style/SplashDemoButton"
            android:text="@string/animation_zoom" />

        <Button
            android:id="@+id/buttonSlideUp"
            style="@style/SplashDemoButton"
            android:text="@string/animation_slide_up" />

        <Button
            android:id="@+id/buttonCurtain"
            style="@style/SplashDemoButton"
            android:text="@string/animation_curtain" />

        <Button
            android:id="@+id/buttonCircularReveal"
            style="@style/SplashDemoButton"
            android:text="@string/animation_circular_reveal" />

        <Button
            android:id="@+id/buttonPulse"
            style="@style/SplashDemoButton"
            android:text="@string/animation_pulse" />

        <Button
            android:id="@+id/buttonRotateLoader"
            style="@style/SplashDemoButton"
            android:text="@string/animation_rotate_loader" />

        <Button
            android:id="@+id/buttonBounceDots"
            style="@style/SplashDemoButton"
            android:text="@string/animation_bounce_dots" />

        <Button
            android:id="@+id/buttonTypewriter"
            style="@style/SplashDemoButton"
            android:text="@string/animation_typewriter" />

        <Button
            android:id="@+id/buttonGradientWave"
            style="@style/SplashDemoButton"
            android:text="@string/animation_gradient_wave" />

        <Button
            android:id="@+id/buttonRipple"
            style="@style/SplashDemoButton"
            android:text="@string/animation_ripple" />

    </LinearLayout>

</ScrollView>
